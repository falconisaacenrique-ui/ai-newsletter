# Copy to .env and fill in. NEVER commit .env.

# --- Claude API ---
ANTHROPIC_API_KEY=

# --- Gmail OAuth (one of two patterns) ---
# Pattern A (local dev): keep credentials.json + token.json files alongside .env
# Pattern B (GitHub Actions): put the JSON contents inline in these vars
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=

# Sender shown in the From: header. Must match the OAuth-authorized account.
NEWSLETTER_FROM=falconisaacenrique@gmail.com
NEWSLETTER_FROM_NAME=AI Daily

# --- GitHub Pages base URL (set after first deploy) ---
# Used to build the "🇺🇸 English / 🇪🇸 Español" toggle links at the top of the email.
PAGES_BASE_URL=https://<your-username>.github.io/<repo-name>

# --- Reddit (no auth needed for /top.json, but a UA is polite) ---
REDDIT_USER_AGENT=ai-newsletter/0.1 by falconisaacenrique

# --- Tuning ---
LOG_LEVEL=info
MODEL_RANKER=claude-opus-4-7
MODEL_TRANSLATOR=claude-sonnet-4-6
