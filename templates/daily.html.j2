<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ strings.brand }} — {{ date }}</title>
<style>{{ css | safe }}</style>
</head>
<body class="{{ lang }}">
<div class="outer">
  <div class="container">

    <div class="masthead">
      <div class="masthead-left">
        <div class="brand"><span class="dot"></span>{{ strings.brand }}</div>
      </div>
      <div class="masthead-right">
        <div class="issue-meta">{{ strings.issue_label }} {{ issue_no }} · {{ date_display }}</div>
      </div>
    </div>


    <div class="pad">

      <h1>{{ ranked.headline_story.title }}</h1>
      {% if ranked.headline_story.dek %}<p class="dek-lead">{{ ranked.headline_story.dek }}</p>{% endif %}

      <div class="tldr">
        <div class="tldr-label">TL;DR · {{ strings.tldr_sub }}</div>
        <ol>
          {% for line in ranked.tldr %}<li>{{ line }}</li>{% endfor %}
        </ol>
      </div>

      <h2>{{ strings.headline }}</h2>
      <div class="item">
        <div class="body">{{ ranked.headline_story.body | safe }}</div>
        {% if ranked.headline_story.so_what %}<span class="so-what">{{ ranked.headline_story.so_what }}</span>{% endif %}
        <div class="source"><a href="{{ ranked.headline_story.url }}">{{ ranked.headline_story.source }}</a></div>
      </div>

      <h2>{{ strings.models }}</h2>
      {% for it in ranked.models_releases %}
      <div class="item">
        <h3><a href="{{ it.url }}">{{ it.title }}</a></h3>
        {% if it.dek %}<span class="dek">{{ it.dek }}</span>{% endif %}
        <div class="body">{{ it.body | safe }}</div>
        {% if it.so_what %}<span class="so-what">{{ it.so_what }}</span>{% endif %}
        <div class="source">{{ it.source }}</div>
      </div>
      {% endfor %}

      <h2>{{ strings.tools }}</h2>
      {% for it in ranked.tools_resources %}
      <div class="item">
        <h3><a href="{{ it.url }}">{{ it.title }}</a></h3>
        {% if it.dek %}<span class="dek">{{ it.dek }}</span>{% endif %}
        <div class="body">{{ it.body | safe }}</div>
        {% if it.so_what %}<span class="so-what">{{ it.so_what }}</span>{% endif %}
        <div class="source">{{ it.source }}</div>
      </div>
      {% endfor %}

      <h2>{{ strings.cool_uses }}</h2>
      {% for it in ranked.cool_uses %}
      <div class="item">
        <h3><a href="{{ it.url }}">{{ it.title }}</a></h3>
        {% if it.dek %}<span class="dek">{{ it.dek }}</span>{% endif %}
        <div class="body">{{ it.body | safe }}</div>
        <div class="source">{{ it.source }}</div>
      </div>
      {% endfor %}

      <div class="monetization">
        <div class="monetization-label">§ {{ strings.monetization_label }}</div>
        <h2>{{ strings.monetization }}</h2>
        <p class="monetization-intro">{{ strings.monetization_intro }}</p>
        {% for a in monetization.angles %}
        <div class="angle">
          <div class="angle-title">{{ a.title }}</div>
          <div class="angle-pills">
            <span class="pill pill-kind">{{ a.kind | replace("_", " ") }}</span>
            <span class="pill pill-effort">{{ a.effort_level | replace("_", " ") }}</span>
            {% if a.revenue_size %}<span class="pill pill-revenue">{{ a.revenue_size }}</span>{% endif %}
          </div>
          <div class="angle-row"><span class="label">{{ strings.who_buys }}</span><span class="val">{{ a.who_buys }}</span></div>
          <div class="angle-row"><span class="label">{{ strings.why_now }}</span><span class="val">{{ a.why_now }}</span></div>
          <div class="angle-row"><span class="label">{{ strings.first_step }}</span><span class="val">{{ a.first_step }}</span></div>
          <div class="angle-row"><span class="label">{{ strings.risk }}</span><span class="val">{{ a.risk_note }}</span></div>
        </div>
        {% endfor %}
      </div>

      <h2>{{ strings.oneliners }}</h2>
      <ul class="oneliners">
        {% for o in ranked.oneliners %}
        <li><strong><a href="{{ o.url }}">{{ o.title }}</a></strong> — {{ o.summary }} <span class="source">({{ o.source }})</span></li>
        {% endfor %}
      </ul>

      <div class="signoff">
        <div class="signoff-name">— {{ strings.signoff_line }}</div>
        <div class="signoff-brand">{{ strings.brand }}</div>
      </div>

    </div>

    <div class="footer">
      {{ strings.footer_archive }} <a href="{{ archive_url }}">{{ strings.archive }}</a> · {{ strings.footer_feedback }}
      <span class="made">{{ strings.footer_made }}</span>
    </div>
  </div>
</div>
</body>
</html>
